NODE_ENV=development
PORT=2000
CLIENT_URL=http://localhost:3000
JWT_SECRET_KEY=
GOOGLE_API_KEY=

# Docker Compose credentials. Choose local values before starting the stack.
MONGO_USER=foodie
MONGO_PASSWORD=
MONGO_DB=foodie
# For a server running on the host; replace credentials with URL-encoded values.
MONGODB_URI=mongodb://foodie:YOUR_PASSWORD@127.0.0.1:27017/foodie?authSource=admin&replicaSet=rs0&directConnection=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
